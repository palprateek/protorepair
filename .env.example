# Optional live Gemini extraction. Leave unset for the offline/structured demo.
GEMINI_API_KEY=

# Optional model override; defaults to gemini-3.5-flash-lite.
GEMINI_MODEL=gemini-3.5-flash-lite

# full = load committed metadata-only evidence snapshot
# none = no-Valency ablation (findings still run; citation coverage becomes 0)
EVIDENCE_MODE=full
